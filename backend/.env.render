# ============================================
# 🚀 RENDER DEPLOYMENT CONFIGURATION
# ============================================
# Copy these variables to Render Dashboard:
# Settings → Environment
#
# ⚠️ DO NOT COMMIT THIS FILE TO GITHUB
# Use Render's secrets management instead
# ============================================

NODE_ENV=production

# ============================================
# AIVEN MYSQL CONFIGURATION
# ============================================
# Preencha com seus dados do Aiven:
# 
# DB_HOST: Servidor do MySQL (ex: paulohbarros99.a.aivencloud.com)
# DB_PORT: Porta (padrão: 13995)
# DB_USER: Usuário de conexão (ex: avnadmin)
# DB_PASS: Senha de conexão
# DB_NAME: Nome do banco de dados (padrão: inkstation)
# DB_SSL: Usar SSL/TLS (padrão: true)

DB_HOST=inkstation-mysql-paulohbarros99.a.aivencloud.com
DB_PORT=13995
DB_USER=seu_usuario_aiven
DB_PASS=sua_senha_aiven
DB_NAME=inkstation
DB_SSL=true

# ============================================
# FRONTEND CONFIGURATION
# ============================================
FRONTEND_URL=https://aluguel-macas.vercel.app

# ============================================
# SERVIDOR
# ============================================
PORT=3000
HOST=0.0.0.0
